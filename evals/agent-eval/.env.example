# Copy to evals/agent-eval/.env (or .env.local). scripts/run.mjs loads it.

# --- Agent credentials (set what your agent needs) ---------------------------
# agent 'claude-code' (the default): an Anthropic API key ...
ANTHROPIC_API_KEY=
# ... or a Claude subscription token from `claude setup-token`. When this is set
# it is used instead of ANTHROPIC_API_KEY.
# CLAUDE_CODE_OAUTH_TOKEN=
# agents 'vercel-ai-gateway/*' (and agent-eval's optional failure classifier):
# AI_GATEWAY_API_KEY=
# agent 'codex': OPENAI_API_KEY   'gemini': GEMINI_API_KEY   'cursor': CURSOR_API_KEY

# --- Sandbox ------------------------------------------------------------------
# With VERCEL_TOKEN (or VERCEL_OIDC_TOKEN) set, sandbox 'auto' uses Vercel
# Sandbox; without it, it uses the local Docker daemon.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# --- Experiment knobs (read by experiments/scenario-01.ts) --------------------
# AGENT_EVAL_AGENT=claude-code
# AGENT_EVAL_MODEL=          # empty = the agent CLI's own default; comma-separate for several
# AGENT_EVAL_RUNS=1
# AGENT_EVAL_SANDBOX=auto    # auto | docker | vercel
# AGENT_EVAL_TIMEOUT=600     # seconds per run

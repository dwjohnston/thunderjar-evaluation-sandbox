import { expect, test } from "bun:test";
import { {{defaultExport}} as baseCommit } from "{{subjectPath}}";

test("test/cart/invoice.test.js and test/cart/totals.test.js are unchanged", () => {
  const result = Bun.spawnSync(
    ["git", "diff", "--exit-code", "--stat", baseCommit, "--", "test/cart/invoice.test.js", "test/cart/totals.test.js"],
    { cwd: "/workspace", stdout: "pipe", stderr: "pipe" },
  );
  if (result.exitCode !== 0) console.log(result.stdout.toString(), result.stderr.toString());
  expect(result.exitCode).toBe(0);
});

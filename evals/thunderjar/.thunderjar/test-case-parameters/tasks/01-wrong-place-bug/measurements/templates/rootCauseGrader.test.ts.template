import { expect, test } from "bun:test";
import { copyFileSync, mkdirSync } from "node:fs";

test("node grading/01_wrong_place_bug/check.js passes", () => {
  mkdirSync("/workspace/grading/01_wrong_place_bug", { recursive: true });
  copyFileSync("/opt/thunderjar-grading/01_wrong_place_bug/check.js", "/workspace/grading/01_wrong_place_bug/check.js");
  const result = Bun.spawnSync(["node", "grading/01_wrong_place_bug/check.js"], { cwd: "/workspace", stdout: "pipe", stderr: "pipe" });
  if (result.exitCode !== 0) console.log(result.stdout.toString(), result.stderr.toString());
  expect(result.exitCode).toBe(0);
});
